# =============================================================================
# CppOJ 运行期配置（SPEC.md §6.7.3 / §9 T0.4）
# 从项目根目录启动（`make run` 保证）；进程环境变量会覆盖这里的同名项。
# 解析规则：# 开头为注释；值可用引号包裹；仅「空白之后的 #」才算行内注释。
# ⚠️ OJ_ADMIN_USERNAMES 是 users.role 的【唯一真源】（D-37），语义分三种：
#    · 未设置（本行注释掉或删掉）→ 启动同步【完全跳过】，role 列零变化
#    · 显式留空（OJ_ADMIN_USERNAMES=）→ 执行同步，结果零 admin（全员降权）
#    · 给了名字 → 名单内提权、名单外降权；不存在的名字会在启动日志里 WARN 点名
#    名单里的用户名必须【已存在】：本文件不会创建用户，顺序是「先注册 → 再填这里 → 重启」
# =============================================================================

# ---- 策略 [D-37] ----
OJ_ALLOW_REGISTER=1
# OJ_ADMIN_USERNAMES=alise        # 角色唯一真源（D-37），须为已存在的用户名

# ---- MySQL（路线 A：宿主机 mysqld；路线 B：compose 注入同格式变量）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=oj
MYSQL_PASSWORD=oj
MYSQL_DB=oj

# ---- HTTP ----
OJ_LISTEN=0.0.0.0:8080
OJ_HTTP_THREADS=8

# ---- Judge [D-74] ----
OJ_JUDGE_WORKERS=2                 # 2 核实测机：4 worker 会自相争抢
OJ_JUDGE_GATE=4                    # 必须 = 2 × OJ_JUDGE_WORKERS，违反则拒绝启动
OJ_JUDGE_USER_GATE=2               # 单用户同时评测数上限（超限 1007）
OJ_FENCE_MULTIPLIER=10             # [D-62] §5.4.2.1 的 ×10，调闸门前必须重算
OJ_JUDGE_WORKDIR=/tmp/oj-judge

# ---- 配额 [D-22] / 会话 ----
OJ_RATE_WINDOW_SECONDS=60
OJ_RATE_MAX_SUBMITS=10
OJ_MAX_CODE_BYTES=65536
OJ_SESSION_TTL_DAYS=7

# ---- 路径与日志 ----
OJ_PROBLEMS_DIR=./problems
OJ_STATIC_DIR=./static
OJ_LOG_DIR=./logs
OJ_LOG_RETENTION_DAYS=7
# 构建产物（CMake 的 build/，也是 compile_commands.json 的真身所在）
build/

# 运行日志：目录本身保留，内容忽略（SPEC §2.1-A 注 2 —— 不用 volume，直接是仓库内目录）
# 两个模式缺一不可：logs/*.log 只匹配当前的 app.log / judge.log，
# 而按天切割（[D-34]、§1.4 保留 7 天）产生的是 app.log.2026-10-10 这种名字，
# 只写前一条会把 7 天的历史日志全提交进仓库。
logs/*.log
logs/*.log.*

# 根目录的编译数据库软链接（指向 build/compile_commands.json，由 CMake 自动维护）
/compile_commands.json
.cache/

# .env 是本地配置，本项目的密码是开发用的明文默认值（dependence.md §4），
# 若将来换成真实口令，请取消下一行注释
#.env